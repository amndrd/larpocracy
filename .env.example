# Supabase — Project Settings → API
# L'URL et la clé publique sont exposées au navigateur : c'est prévu.
# La sécurité repose sur les policies RLS de supabase/schema.sql, pas sur le secret de la clé.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NE JAMAIS mettre ici la clé service_role / secret : elle contourne toute la RLS.
